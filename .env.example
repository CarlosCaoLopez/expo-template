# =============================================================================
# MONOREPO ROOT - SHARED ENVIRONMENT VARIABLES (expo-template)
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# =============================================================================

# --- Database ---
# docker-compose maps host 5433 -> container 5432
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Redis ---
REDIS_URL=

# --- JWT ---
# Must be at least 32 chars for backend validation
JWT_SECRET=
JWT_EXPIRES_IN=

# --- Backend ---
PORT=
BACKEND_PORT=
BACKEND_URL=
NODE_ENV=

# --- Expo app ---
# EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_URL=

# --- MCP Server ---
MCP_TRANSPORT=
MCP_HTTP_PORT=
